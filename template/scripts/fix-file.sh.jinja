{% if language == 'python' -%}
#!/usr/bin/env bash
f="${1:-}"
[[ "$f" == *.py && -f "$f" ]] || exit 0
root="$(git rev-parse --show-toplevel 2>/dev/null)"
if [[ -n "$root" && -d "$root/.venv/bin" ]]; then
  export PATH="$root/.venv/bin:$PATH"
fi
ruff format -q "$f"
ruff check --fix -q "$f" >/dev/null
out=$(ruff check "$f" 2>&1) || { echo "$out" >&2; exit 2; }
{% else -%}
#!/usr/bin/env bash
# Post-edit hook: formats and lints the one edited Swift file. No `swiftlint --fix`: its empty_count autocorrect
# rewrote a test fake's call counter (`provider.count == 0`) as `provider.isEmpty`, which does not compile.
set -euo pipefail
file="${1:-}"
[[ "$file" == *.swift && -f "$file" ]] || exit 0
root="$(git rev-parse --show-toplevel)"
# SwiftLint finds sourcekitd through Xcode's layout; under the Command Line Tools it must be pointed at them.
developer_dir="${DEVELOPER_DIR:-$(xcode-select -p 2>/dev/null || true)}"
[[ "$developer_dir" == /Library/Developer/CommandLineTools ]] && export TOOLCHAIN_DIR="$developer_dir"
xcrun swift-format format --configuration "$root/.swift-format" --in-place "$file"
xcrun swift-format lint --configuration "$root/.swift-format" --strict "$file"
{% if swift_adoption == 'existing' -%}
# Editing a file brings it under the changed-files format gate. SwiftLint fails only on violations missing from the
# baseline, given the file as an absolute path in Foundation's standardised form so baseline entries match.
file="$(cd "$(dirname "$file")" && pwd -P)/$(basename "$file")"
cd "$root"
source scripts/standard-root.sh
file="$(standard_root)/${file#"$(pwd -P)"/}"
swiftlint lint --config .swiftlint.yml --strict --quiet --no-cache --baseline .harness/swiftlint-baseline.json "$file"
{% else -%}
swiftlint lint --config "$root/.swiftlint.yml" --strict --quiet --no-cache "$file"
{% endif -%}
{% endif %}
