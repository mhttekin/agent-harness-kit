{% raw %}#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
# Git's ignores exclude .build, DerivedData, downloaded packages and virtualenvs.
files=()
while IFS= read -r -d '' file; do
  [[ -f "$file" ]] && files+=("$file")
done < <(git ls-files --cached --others --exclude-standard -z -- '*.swift')
[[ ${#files[@]} -gt 0 ]] || { echo 'No Swift sources found.' >&2; exit 1; }
case "${1:-all}" in
  format) xcrun swift-format lint --strict "${files[@]}" ;;
  lint) swiftlint lint --strict --quiet --no-cache "${files[@]}" ;;
  all)
    xcrun swift-format lint --strict "${files[@]}"
    swiftlint lint --strict --quiet --no-cache "${files[@]}"
    ;;
  *) echo 'usage: swift-quality.sh [format|lint|all]' >&2; exit 2 ;;
esac
{% endraw %}
